<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Partner Portal — {{ decoy_website_brand_name }}</title>
<link rel="stylesheet" href="/style.css"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="icon" href="/favicon.ico" sizes="32x32"><meta name="theme-color" content="#1f4e7a">
</head>
<body>
<div class="signin">
  <aside class="panel">
    <div class="logo"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22 16 6l12 16M9 22l7-9 7 9M4 26h24"/></svg><span class="serif">{{ decoy_website_brand_name }}</span></div>
    <div>
      <h1 class="serif">Partner Portal</h1>
      <p>Shipment tracking, invoices and dispatch documents for contracted carriers and freight forwarders.</p>
      <ul>
        <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5 6.5 12 13 4.5"/></svg> Real-time consignment status</li>
        <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5 6.5 12 13 4.5"/></svg> CMR, POD and customs documents</li>
        <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5 6.5 12 13 4.5"/></svg> Monthly settlement statements</li>
      </ul>
    </div>
    <div class="note">Access is restricted to authorised partner accounts. Activity is logged in accordance with the Partner Agreement.</div>
  </aside>
  <div class="formcol">
    <form method="post" action="/login">
      <div><h2>Sign in</h2><p class="sub">Enter the work email registered with your partner account.</p></div>
      <div class="field"><label for="email">Work email</label><input id="email" name="email" type="email" placeholder="name@company.com" required autocomplete="email"></div>
      <button class="btn" type="submit">Send sign-in link</button>
      <div class="hint">We'll email you a one-time link. It expires in 15 minutes.</div>
    </form>
    <div class="footer"><a href="/privacy">Privacy</a><a href="/terms">Terms</a><span>© {{ ansible_date_time.year }} {{ decoy_website_brand_name }}</span></div>
  </div>
</div>
</body>
</html>
