<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Check your email — {{ decoy_website_brand_name }}</title>
<link rel="stylesheet" href="/style.css"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="icon" href="/favicon.ico" sizes="32x32"><meta name="theme-color" content="#1f4e7a">
</head>
<body>
<div class="center">
  <div class="logo"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22 16 6l12 16M9 22l7-9 7 9M4 26h24"/></svg><span class="serif">{{ decoy_website_brand_name }}</span></div>
  <div class="card">
    <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></div>
    <h1>Check your email</h1>
    <p>If that address is registered to a partner account, we've sent a one-time sign-in link. It expires in 15 minutes.</p>
    <p style="font-size:14px">Didn't get it? Check spam, or <a href="/">try again</a>.</p>
  </div>
  <div class="footer"><a href="/privacy">Privacy</a><a href="/terms">Terms</a><span>© {{ ansible_date_time.year }} {{ decoy_website_brand_name }}</span></div>
</div>
</body>
</html>
