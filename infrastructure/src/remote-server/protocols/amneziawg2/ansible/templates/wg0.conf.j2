[Interface]
PrivateKey = {{ amneziawg2_server_private_key }}
Address = {{ amneziawg2_address }}
ListenPort = {{ amneziawg2_port }}
MTU = {{ amneziawg2_mtu }}

Jc = {{ amneziawg2_obfuscation.jc }}
Jmin = {{ amneziawg2_obfuscation.jmin }}
Jmax = {{ amneziawg2_obfuscation.jmax }}
S1 = {{ amneziawg2_obfuscation.s1 }}
S2 = {{ amneziawg2_obfuscation.s2 }}
S3 = {{ amneziawg2_obfuscation.s3 }}
S4 = {{ amneziawg2_obfuscation.s4 }}
H1 = {{ amneziawg2_obfuscation.h1 }}
H2 = {{ amneziawg2_obfuscation.h2 }}
H3 = {{ amneziawg2_obfuscation.h3 }}
H4 = {{ amneziawg2_obfuscation.h4 }}
I1 = {{ amneziawg2_obfuscation.i1 }}
{% for signature_key in ["i2", "i3", "i4", "i5"] %}
{% if amneziawg2_obfuscation[signature_key] is defined %}
{{ signature_key | upper }} = {{ amneziawg2_obfuscation[signature_key] }}
{% endif %}
{% endfor %}

PostUp = iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE
PostDown = iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE

PostUp = iptables -A FORWARD -i %i -o %i -j DROP
PostDown = iptables -D FORWARD -i %i -o %i -j DROP

PostUp = iptables -A FORWARD -i %i -d 10.0.0.0/8 -j DROP
PostUp = iptables -A FORWARD -i %i -d 172.16.0.0/12 -j DROP
PostUp = iptables -A FORWARD -i %i -d 192.168.0.0/16 -j DROP
PostDown = iptables -D FORWARD -i %i -d 10.0.0.0/8 -j DROP
PostDown = iptables -D FORWARD -i %i -d 172.16.0.0/12 -j DROP
PostDown = iptables -D FORWARD -i %i -d 192.168.0.0/16 -j DROP
{% for peer in amneziawg2_peers %}

[Peer]
PublicKey = {{ peer.publicKey }}
PresharedKey = {{ peer.presharedKey }}
AllowedIPs = {{ peer.clientIp }}/32
{% endfor %}
