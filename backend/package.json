{
  "name": "@vancloak/backend",
  "type": "module",
  "private": true,
  "scripts": {
    "api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "start": "NODE_ENV=production node --enable-source-maps dist/api/index.mjs",
    "worker:start": "NODE_ENV=production node --enable-source-maps dist/worker/index.mjs",
    "build": "tsx build.ts",
    "typecheck": "tsc --noEmit",
    "test": "docker compose -f ../docker-compose.yml up -d --wait postgres-test redis-test && vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:integration": "docker compose -f ../docker-compose.yml up -d --wait postgres-test redis-test && vitest run --project integration",
    "test:coverage": "docker compose -f ../docker-compose.yml up -d --wait postgres-test redis-test && vitest run --coverage",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "pnpm dlx @better-auth/cli generate --output src/core/database/schemas/authSchema.ts --yes"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@orpc/contract": "^1.14.13",
    "@orpc/openapi": "^1.14.13",
    "@orpc/server": "^1.14.13",
    "@sindresorhus/slugify": "^3.0.0",
    "better-auth": "^1.6.14",
    "bullmq": "^5.79.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "execa": "^9.6.1",
    "hono": "^4.7.10",
    "ioredis": "^5.11.1",
    "nanoid": "^5.1.9",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "slugify": "^1.6.9",
    "transliteration": "^2.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.1",
    "@vancloak/api-contract": "workspace:*",
    "@vancloak/infrastructure": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
